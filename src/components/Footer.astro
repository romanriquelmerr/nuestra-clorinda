---
const categorias = [
  ['Política', '/categoria/politica'],
  ['Sociedad', '/categoria/sociedad'],
  ['Policiales', '/categoria/policiales'],
  ['Deportes', '/categoria/deportes'],
  ['Economía', '/categoria/economia'],
  ['Cultura', '/categoria/cultura'],
  ['Región', '/categoria/region'],
];
---

<footer>
  <div class="container">
    <div class="footer-grid">
      <div>
        <a href="/" class="logo" style="color:#fff">Nuestra <span style="color:var(--accent)">Clorinda</span></a>
        <p style="font-size:.9rem;margin-top:.75rem;max-width:28ch">
          Portal de noticias de Clorinda, Formosa: política, sociedad, policiales, deportes, economía y cultura.
        </p>
      </div>
      <div>
        <h3>Secciones</h3>
        <ul>
          {categorias.map(([nombre, url]) => (
            <li><a href={url}>{nombre}</a></li>
          ))}
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} Nuestra Clorinda. Todos los derechos reservados.</span>
      <span>Hecho con Astro y Cloudflare Pages.</span>
    </div>
  </div>
</footer>
