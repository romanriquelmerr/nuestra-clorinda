---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada — Nuestra Clorinda" description="La página que buscás no existe.">
  <div class="container" style="text-align:center;padding:6rem 1rem">
    <h1 style="font-size:2.5rem">404</h1>
    <p style="color:var(--text-2);margin:1rem 0 2rem">La página que buscás no existe o fue movida.</p>
    <a class="btn" href="/">Volver al inicio</a>
  </div>
</BaseLayout>
